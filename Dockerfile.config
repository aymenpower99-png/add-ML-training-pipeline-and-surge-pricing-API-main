# ══════════════════════════════════════════════════════════════════
# Dockerfile.config — Config Admin API (Flask)
# ══════════════════════════════════════════════════════════════════
# Service: Config API
# Port: 5000 (Railway injects $PORT)
# Entry: gunicorn api_config:app
# ══════════════════════════════════════════════════════════════════

FROM python:3.11-slim

# ── System deps ──
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# ── Working dir ──
WORKDIR /app

# ── Install Python deps ──
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Copy app code ──
COPY . .

# ── Expose & run ──
# Gunicorn is production-ready for Flask (unlike app.run())
EXPOSE 5000
CMD ["sh", "-c", "gunicorn -w 2 -b 0.0.0.0:${PORT:-5000} api_config:app"]
